# ==========================================
# AyurRaksha Production Environment Config
# ==========================================

# Public Storefront Production Domain
NEXT_PUBLIC_SITE_URL=https://ayurrakshaonline.com

# Headless WordPress & WooCommerce API Source
WORDPRESS_API_URL=https://cms.ayurrakshaonline.com
NEXT_PUBLIC_WORDPRESS_URL=https://cms.ayurrakshaonline.com

# Razorpay Payment Gateway (Public Key ID)
# Live key prefix: rzp_live_... | Test key prefix: rzp_test_...
RAZORPAY_KEY_ID=rzp_live_kWyXoOFkrDjUBk
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_kWyXoOFkrDjUBk

# Google Marketing Platform (Optional - injects tracking if configured)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# Meta Pixel (Facebook Pixel) & Conversions API
# Assigned Pixel ID: 3646833112247628
NEXT_PUBLIC_META_PIXEL_ID=3646833112247628
META_PIXEL_ID=3646833112247628

# Meta Conversions API Access Token (Generate in Meta Events Manager -> Settings -> Generate Access Token)
# Never expose this token in client-side code or public variables
META_ACCESS_TOKEN=

# Meta Test Event Code (Optional - for Events Manager "Test Events" tab validation e.g. TEST12345)
META_TEST_EVENT_CODE=
